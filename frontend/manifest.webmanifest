{
  "name": "Jarvis Workspace",
  "short_name": "Jarvis",
  "description": "Your fleet of code agents, in one app.",
  "lang": "en",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "landscape",
  "background_color": "#090D18",
  "theme_color": "#090D18",
  "icons": [
    {
      "src": "/static/shared/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any",
      "purpose": "any"
    },
    {
      "src": "/static/shared/icons/jarvis-192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/static/shared/icons/jarvis-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/static/shared/icons/jarvis-maskable-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/static/shared/icons/jarvis-monochrome-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "monochrome"
    }
  ]
}
