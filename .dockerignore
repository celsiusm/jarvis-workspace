# ── .dockerignore — what does NOT enter the build context (smaller = faster
#    build, and we NEVER bake secrets/local state into the image) ──────────────

# Host virtualenv (reinstalled inside the image; it weighs hundreds of MB)
venv/
.venv/

# Local app state: DB + WAL, access token, CLI account secrets, remote browser
# profile, scrollbacks. It must NEVER end up inside the image (it is a runtime
# volume). The Dockerfile creates an empty /app/data.
data/
jarvis.db

# Git: we do not ship history to third parties. The app boots fine without .git
# (the updater goes inert, which is correct in an image deploy).
.git/
.gitignore
.githooks/

# Secrets / environment
.env
plotspace/.env
*.env

# Python bytecode / caches
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Per-project artifact + agent coordination state (ephemeral, dev-only)
.workspace/
.jarvis/

# Logs
*.log

# Node (defensive: there should be none in the repo)
node_modules/

# Analysis/review/IDE tooling and dev notes (not part of the product)
.superpowers/
static_analysis_semgrep_*/
.full-review/
.vscode/
.pytest_cache/
frase.txt
.wb-neon-reference.html

# OS
.DS_Store
Thumbs.db

# The Docker files themselves are not needed inside the context
Dockerfile
docker-compose.yml
.dockerignore
