# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Environment / secrets
.env
plotspace/.env
backend/.env

# Local app state — the ENTIRE data/ dir (DB + WAL, token, remote browser
# profile, Jarvis AI attachments, terminal scrollbacks, Telegram config).
# Nothing here is versioned: there was already a committed-token incident
# (see .jarvis/memory/incidente-token-en-git.md — rotate FIRST if it happens).
data/
jarvis.db

# Per-project artifact generated by jarvis (terminal logs + STATE.md)
.workspace/

# Live agent state (ephemeral, regenerated by agent_live)
.jarvis/LIVE.md
# Coordination chatter between agents + internal handoff docs (not public)
.jarvis/MAILBOX.md
.jarvis/MAILBOX-archivo.md
.jarvis/design-elevaciones.md
# Local swarm journal (each clone has its own; not versioned)
.jarvis/memory/*.md
# Per-terminal runtime signals written by the swarm telemetry (never versioned)
.jarvis/signals/*.json

# LOCAL CLI config: it has each machine's paths.
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db

# Visual companion (brainstorming)
.superpowers/

# Labs / scratch — not the product
frontend/complot-*/
frontend/preview-*/
frontend/*-studio/
frontend/*-redesign/
frontend/radio-studio/
frontend/radio-sintonia/

# Static analysis / review artifacts (tool output, not versioned)
static_analysis_semgrep_*/
.full-review/

# Local brainstorming note (not part of the product)
frase.txt
.pytest_cache/

# Rust (desktop shell)
desktop/core/target/
desktop/src-tauri/target/
desktop/termhost/target/
# The installer bundle: built by packaging/armar_bundle.py on each build.
desktop/src-tauri/motor/*
!desktop/src-tauri/motor/LEEME.md
dist/bundle/
desktop/src-tauri/gen/

# Desktop shell build output and
# QA screenshots (480 PNGs, 212 MB). They were never versioned, but with no
# ignore rule `git add -A` ate them — and that KILLED the WIP safety net
# (core/wip_snapshots.py): its snapshot every 30 min started taking ~60s of CPU
# against a 120s timeout, and on a loaded box it blew up silently.
# Five days with not a single photo of the dirty tree, and 1.1 GB of .git hashing
# installers. See the deep-work memory on swarm coordination.
desktop/dist/
.jarvis/qa-shots/
server.pid
.jarvis/mailbox-pendientes.json
.jarvis/jv
desktop/engine/target/
